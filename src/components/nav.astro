---
// STAGING_SOCIALS_UPDATED 2026-01-27 21:16 UTC
/**
 * nav.astro (v53)
 * Based on V40_FIXED patterns, adds:
 * - Social icons row (SVG logos)
 * - Local clock
 * - Ticker row (aligned to .container)
 */
const BASE = import.meta.env.BASE_URL || "/";
const withBase = (p) => {
  const clean = String(p || "");
  return clean.startsWith("/") ? `${BASE}${clean.slice(1)}` : `${BASE}${clean}`;
};

const links = [
  { href: "#launchpanel", label: "Launch Panel" },
  { href: "#venues", label: "Markets" },
  { href: "#tokenomics", label: "Tokenomics" },
  { href: "#roadmap", label: "Roadmap" },
  { href: withBase("/genesis/"), label: "Genesis Council" },
  { href: "#community", label: "Community" },
  { href: "#faq", label: "FAQ" },
  { href: withBase("/verify/"), label: "Verify" },
  { href: withBase("/whitepaper/"), label: "Whitepaper", cta: true },
];

const localSocialIcon = (key) => withBase(`/social/${key}.svg`);
const faviconSrc = (href) => {
  try {
    const host = new URL(String(href)).hostname;
    return host ? `https://www.google.com/s2/favicons?domain=${host}&sz=64` : "";
  } catch {
    return "";
  }
};
const svgDataUri = (svg) => `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg || "")}`;

const socials = [
  { key: "x",  label: "X",         href: "https://x.com/Capitokenorg", enabled: true, icon: localSocialIcon("x") },
  { key: "tg", label: "Telegram",  href: "https://t.me/CapitokenOfficial", enabled: true, icon: localSocialIcon("tg") },
  { key: "dc", label: "Discord",   href: "https://discord.gg/XVHVaVWPq5", enabled: true, icon: localSocialIcon("dc") },
  { key: "rd", label: "Reddit",    href: "https://www.reddit.com/user/CapiToken/", enabled: true, icon: localSocialIcon("rd") },
  { key: "yt", label: "YouTube",   href: "https://www.youtube.com/channel/UCY5xCVzo-k6hGdR4xhUhTNQ", enabled: true, icon: localSocialIcon("yt") },
  { key: "md", label: "Medium",    href: "https://medium.com/@info_43649", enabled: true, icon: localSocialIcon("md") },
  { key: "ig", label: "Instagram", href: "https://www.instagram.com/capitoken.official/", enabled: true, icon: localSocialIcon("ig") },
  { key: "fb", label: "Facebook",  href: "https://www.facebook.com/Capitoken.official/", enabled: true, icon: localSocialIcon("fb") },
  { key: "tt", label: "TikTok",    href: "https://www.tiktok.com/@capitoken.official/", enabled: true, icon: localSocialIcon("tt") },
];


const ICONS = {
  x:  `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.2l-4.9-6.3L6.4 22H3.3l7.3-8.4L1 2h6.3l4.4 5.7L18.9 2Zm-1.1 18h1.7L6.2 3.9H4.4L17.8 20Z"/></svg>`,
  tg: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.9 4.6 19 20.8c-.2 1.2-1 1.5-2 .9l-5.6-4.1-2.7 2.6c-.3.3-.6.6-1.2.6l.4-6.1L19 5.6c.5-.4-.1-.7-.8-.3L4.9 13.6l-5.7-1.8c-1.2-.4-1.2-1.2.3-1.8L20.3 3c1-.4 1.8.2 1.6 1.6Z"/></svg>`,
  dc: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 4.3A19.9 19.9 0 0 0 16.6 3c-.2.4-.5 1-.7 1.5a18.6 18.6 0 0 0-7.7 0c-.2-.5-.5-1.1-.7-1.5A20 20 0 0 0 3.7 4.3C1.4 7.7.8 11 .9 14.3a20 20 0 0 0 6.2 3.2c.5-.7 1-1.5 1.3-2.3a12 12 0 0 1-2-.9l.5-.4c3.9 1.8 8.1 1.8 12 0l.5.4c-.6.4-1.3.7-2 .9.4.8.8 1.6 1.3 2.3a20 20 0 0 0 6.2-3.2c.2-3.8-.8-7-2.9-10ZM8.6 13.2c-.7 0-1.2-.7-1.2-1.5s.5-1.5 1.2-1.5 1.2.7 1.2 1.5-.5 1.5-1.2 1.5Zm6.8 0c-.7 0-1.2-.7-1.2-1.5s.5-1.5 1.2-1.5 1.2.7 1.2 1.5-.5 1.5-1.2 1.5Z"/></svg>`,
  rd: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.3 2.5a1 1 0 0 0-1.2.7l-1 3.3c-2.1-.1-4.1.4-5.7 1.4l-2.6-2a1 1 0 1 0-1.2 1.6l2.4 1.9C3.5 11 2.6 12.8 2.6 14.8c0 3.7 4.2 6.7 9.4 6.7s9.4-3 9.4-6.7c0-2-1-3.8-2.7-5.1l2.4-1.9a1 1 0 0 0-1.2-1.6l-2.6 2c-1.6-1-3.6-1.5-5.7-1.4l1-3.3a1 1 0 0 0-.7-1.2ZM8.8 14.2a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Zm6.4 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Z"/></svg>`,
  yt: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.3c.2.8.4 2 .4 4.7s-.2 3.9-.4 4.7a2.8 2.8 0 0 1-2 2c-.8.2-3 .4-7.6.4s-6.8-.2-7.6-.4a2.8 2.8 0 0 1-2-2C2.2 15.6 2 14.4 2 12s.2-3.9.4-4.7a2.8 2.8 0 0 1 2-2C5.2 5.1 7.4 5 12 5s6.8.2 7.6.4a2.8 2.8 0 0 1 2 2ZM10 15.3 16 12 10 8.7v6.6Z"/></svg>`,
  md: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.2h4.1l3.2 7.2 3.2-7.2H18v11.6h-2.7V9.4l-3.2 7.1h-1.8L7.1 9.4v8.4H4V6.2Z"/></svg>`,
  ig: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Z"/></svg>`,
  fb: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.5 1.6-4.5 4.7V11H7v3h2.6v8h3.9Z"/></svg>`,
  tt: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.7 8.2c-1.2-.8-2-2.2-2.1-3.7V3h-3.5v12.1c0 1.3-1 2.3-2.3 2.3-1.3 0-2.3-1-2.3-2.3 0-1.3 1-2.3 2.3-2.3.3 0 .6.1.9.2V9.4c-.3-.1-.6-.1-.9-.1-3.1 0-5.6 2.5-5.6 5.6S5.7 20.5 8.8 20.5s5.6-2.5 5.6-5.6V10c1.2.9 2.7 1.4 4.3 1.4V7.9c-.7 0-1.4-.2-2-.6z"/></svg>`,
};

const domainFromHref = (href) => {
  try {
    return new URL(String(href)).hostname;
  } catch {
    return "";
  }
};
---

<header class="nav nav--stack">
  <div class="container nav__inner">
    <a class="brand" href={withBase("/")} aria-label="Capitoken home">
      <img class="brand__img" src={withBase("/brand/logo-navbar.png")} alt="Capitoken" />
    </a>

    <nav class="nav__links" aria-label="Primary navigation">
      {links.map((l) => (
        <a class={l.cta ? "btn btn--mini btn--primary nav__cta" : "nav__link"} href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>

  <div class="nav__meta">
    <div class="container nav__meta-inner">
      <div class="nav__socials" aria-label="Social links">
        {socials.map((s) => (
          <a
            class={`social__icon ${s.enabled ? "" : "is-disabled"}`}
            href={s.enabled ? s.href : undefined}
            aria-label={s.enabled ? s.label : (s.label + " (coming soon)")}
            title={s.enabled ? s.label : (s.label + " (coming soon)")}
            target={s.enabled ? "_blank" : undefined}
            rel={s.enabled ? "noopener noreferrer" : undefined}
          >
            {s.enabled ? (
              <img
                class="social__img"
                src={s.icon}
                data-fallback1={faviconSrc(s.href)}
                data-fallback2={svgDataUri(ICONS[s.key] ?? "")}
                onerror="if(!this.dataset._fb){this.dataset._fb='1'; this.src=this.dataset.fallback1 || this.dataset.fallback2;} else if(this.dataset._fb==='1'){this.dataset._fb='2'; this.src=this.dataset.fallback2;} else {this.onerror=null;}"
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            ) : (
              <span class="social__svg" set:html={ICONS[s.key] ?? ""} />
            )}
          </a>
        ))}
      </div>

      
      <div id="navRenounce" class="nav__renounce" aria-label="Token contract renounce countdown">
        <div class="renounce__title">Token Contract Renounce Countdown</div>
        <div class="renounce__label" id="renounceLabel">RENOUNCE IN:</div>
        <div class="renounce__timer" aria-hidden="false">
          <div class="renounce__box"><div class="renounce__num" id="renDays">00</div><div class="renounce__unit">DAYS</div></div>
          <div class="renounce__box"><div class="renounce__num" id="renHours">00</div><div class="renounce__unit">HOURS</div></div>
          <div class="renounce__box"><div class="renounce__num" id="renMins">00</div><div class="renounce__unit">MIN</div></div>
          <div class="renounce__box"><div class="renounce__num" id="renSecs">00</div><div class="renounce__unit">SEC</div></div>
        </div>
      </div>

<div id="navClock" class="nav__clock" aria-label="Local time"></div>
    </div>
  </div>

  <div class="nav__ticker" role="region" aria-label="Market ticker">
    <div class="container tickerbar__inner">
      <span class="tickerbar__tag">LIVE</span>
      <div class="tickerbar__viewport">
        <div class="tickerbar__track">
          <div id="ticker" class="ticker" aria-live="polite">Loading prices…</div>
          <div class="ticker ticker--clone" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</header>