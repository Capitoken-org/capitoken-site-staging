---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CAPI Genesis Council">
  <main class="gc-page">
    <section class="gc-hero">
      <div class="gc-breadcrumb">
        <span class="gc-dot"></span>
        <span>Genesis Council</span>
      </div>

      <h1 class="gc-title">CAPI Genesis Council</h1>
      <p class="gc-subtitle">
        This page is an on-chain eligibility portal. Connect your wallet to see your exact CAPI balance
        and how much you're missing. This NFT is an optional membership layer for identity and
        community direction. It does not grant financial rights. If it's not listed on capitoken.org,
        assume it's not official.
      </p>

      <div class="gc-actions">
        <button id="gcConnect" class="btn btn-primary">Connect Wallet</button>
        <button id="gcRefresh" class="btn">Refresh</button>
        <button id="gcViewMeta" class="btn">View Metadata</button>
        <a id="gcRawJsonLink" class="btn" href="/genesis/metadata/1.json" target="_blank" rel="noreferrer">Raw JSON</a>
      </div>

      <div class="gc-meta">
        <div class="gc-meta__row">
          <span class="gc-meta__label">Wallet:</span>
          <span class="gc-meta__val mono" id="gcWallet">—</span>
          <span class="gc-chip" id="gcNet">Network</span>
          <span class="gc-chip gc-chip--ok" id="gcChain">Ethereum Mainnet</span>
        </div>
        <div class="gc-meta__row">
          <span class="gc-meta__label">Mint closes in:</span>
          <span class="gc-meta__val mono" id="gcCountdown">—</span>
          <span class="gc-meta__label">Close time (UTC):</span>
          <span class="gc-meta__val mono" id="gcCloseUtc">—</span>
        </div>
      </div>
    </section>

    <section class="gc-grid">
      <div class="gc-card">
        <div class="gc-card__head">
          <div class="gc-card__title">Eligibility (On-chain)</div>
        </div>

        <div class="gc-elig">
          <div class="gc-elig__row">
            <div class="gc-elig__k">Required</div>
            <div class="gc-elig__v mono" id="gcReq">≥ 150,000,000 CAPI</div>
          </div>
          <div class="gc-elig__row">
            <div class="gc-elig__k">Your balance</div>
            <div class="gc-elig__v mono" id="gcBal">—</div>
          </div>
          <div class="gc-elig__row">
            <div class="gc-elig__k">Short by</div>
            <div class="gc-elig__v mono" id="gcShort">—</div>
          </div>

          <div class="gc-pill" id="gcStatus">
            <span class="gc-pill__dot"></span>
            <span class="gc-pill__txt">—</span>
          </div>

          <p class="gc-note">
            Balance is read directly from the official CAPI contract. If your wallet is on the wrong network,
            we'll ask you to switch — and we also use a safe read-only RPC fallback for reliability.
          </p>

          <div class="gc-cta">
            <a class="btn" href="/#launch-panel">Go to Launch Panel</a>
            <a class="btn" href="/#verify">Verify Official Links</a>
          </div>
        </div>
      </div>

      <div class="gc-card">
        <div class="gc-card__head">
          <div class="gc-card__title">Mint (ERC-721)</div>
        </div>

        <div class="gc-mint">
          <div class="gc-mint__grid">
            <div class="gc-mint__cell">
              <div class="gc-mint__k">Max supply</div>
              <div class="gc-mint__v mono" id="gcMax">7000</div>
            </div>
            <div class="gc-mint__cell">
              <div class="gc-mint__k">Max per wallet</div>
              <div class="gc-mint__v mono" id="gcPer">1</div>
            </div>
            <div class="gc-mint__cell">
              <div class="gc-mint__k">Contract</div>
              <div class="gc-mint__v mono" id="gcNftContract">TBA</div>
            </div>
          </div>

          <p class="gc-note">
            Mint is free (gas only). The official contract address will be posted here once deployed
            and verified.
          </p>

          <button id="gcMint" class="btn btn-primary" disabled>Mint (coming soon)</button>
          <div class="gc-mint__elig" id="gcMintHint">—</div>

          <div class="gc-nft">
            <img src="/genesis/images/genesis.png" alt="Genesis Council NFT" loading="lazy" />
            <p class="gc-nft__note">
              Safety: never trust DMs. Always verify the contract address on this website before interacting.
            </p>
          </div>
        </div>
      </div>
    </section>

    <p class="gc-footer-note">
      This portal is designed to drive on-chain participation through transparent rules — not promises.
    </p>

    <!-- Metadata Modal -->
    <div class="gc-modal" id="gcMetaModal" aria-hidden="true">
      <div class="gc-modal__backdrop" data-close="1"></div>
      <div class="gc-modal__panel" role="dialog" aria-modal="true" aria-label="Genesis Council Metadata">
        <div class="gc-modal__head">
          <div class="gc-modal__badge">
            <span class="gc-dot"></span>
            <span>Metadata</span>
          </div>
          <button class="gc-modal__close" id="gcMetaClose" data-close="1" aria-label="Close">×</button>
        </div>

        <h3 class="gc-modal__title">Genesis Council Metadata</h3>
        <p class="gc-modal__sub">Friendly preview for non-technical users. Raw JSON is still available.</p>

        <div class="gc-modal__count">
          <div class="gc-count__k">MINT CLOSES IN</div>
          <div class="gc-count__v mono" id="gcMetaCountdown">—</div>
          <div class="gc-count__u mono">UTC <span id="gcMetaUtc">—</span></div>
        </div>

        <div class="gc-meta-grid">
          <div class="gc-meta-grid__img">
            <img id="gcMetaImage" src="/genesis/images/genesis.png" alt="Genesis Council image" />
          </div>

          <div class="gc-meta-grid__body">
            <div class="gc-meta-grid__top">
              <div>
                <div class="gc-meta-grid__k">Name</div>
                <div class="gc-meta-grid__v" id="gcMetaName">—</div>
              </div>
              <div>
                <div class="gc-meta-grid__k">Description</div>
                <div class="gc-meta-grid__v" id="gcMetaDesc">—</div>
              </div>
              <div>
                <div class="gc-meta-grid__k">External URL</div>
                <a class="gc-meta-grid__v gc-link" id="gcMetaExt" href="#" target="_blank" rel="noreferrer">—</a>
              </div>
            </div>

            <div class="gc-meta-grid__attrs">
              <div class="gc-meta-grid__k">Attributes</div>
              <div id="gcMetaAttrs" class="gc-attrs"></div>
            </div>

            <div class="gc-meta-grid__actions">
              <a id="gcMetaRaw" class="btn" href="/genesis/metadata/1.json" target="_blank" rel="noreferrer">Open Raw JSON</a>
              <button id="gcMetaCopy" class="btn btn-primary" type="button">Copy JSON</button>
              <div class="gc-hint" id="gcMetaHint"></div>
            </div>

            <p class="gc-modal__footnote">
              If anything here disagrees with the official contract address shown on this page, treat it as unverified.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .gc-page{
      width: min(1120px, calc(100% - 48px));
      margin: 0 auto;
      padding: 18px 0 12px;
    }
    .gc-hero{ padding-top: 2px; }
    .gc-breadcrumb{ display:flex; gap:8px; align-items:center; opacity:.9; margin-bottom:10px; }
    .gc-dot{ width:7px; height:7px; border-radius:999px; background: #f59e0b; display:inline-block; }
    .gc-title{ font-size: 44px; line-height: 1.05; margin: 8px 0 10px; }
    .gc-subtitle{ max-width: 820px; opacity: .92; }
    .gc-actions{ display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      gap:8px;
      padding:9px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(0,0,0,.18);
      color:#fff;
      text-decoration:none;
      cursor:pointer;
      font-weight:600;
      font-size:13px;
    }
    .btn:hover{ border-color: rgba(255,255,255,.24); background: rgba(0,0,0,.22); }
    .btn-primary{
      background: rgba(245,158,11,.82);
      border-color: rgba(245,158,11,.9);
      color:#111;
    }
    .btn-primary:hover{ background: rgba(245,158,11,.92); }

    .gc-meta{ margin-top: 12px; display:flex; flex-direction:column; gap:6px; }
    .gc-meta__row{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; opacity:.95; }
    .gc-meta__label{ opacity:.75; }
    .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
    .gc-chip{
      font-size:11px; padding:4px 8px; border-radius:999px;
      border:1px solid rgba(255,255,255,.16);
      background: rgba(0,0,0,.18);
      opacity:.9;
    }
    .gc-chip--ok{ border-color: rgba(34,197,94,.35); background: rgba(34,197,94,.10); }

    .gc-grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 18px;
    }
    @media (max-width: 980px){
      .gc-grid{ grid-template-columns:1fr; }
      .gc-title{ font-size: 38px; }
      .gc-page{ width: min(1120px, calc(100% - 28px)); }
    }

    .gc-card{
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      backdrop-filter: blur(10px);
      padding: 14px 14px 16px;
      min-height: 330px;
    }
    .gc-card__head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
    .gc-card__title{ font-weight:800; letter-spacing:.02em; opacity:.95; }

    .gc-elig__row{
      display:grid;
      grid-template-columns: 130px 1fr;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .gc-elig__k{ opacity:.8; }
    .gc-elig__v{ text-align:left; }
    .gc-pill{
      margin-top:10px;
      display:flex; gap:8px; align-items:center;
      padding: 8px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      width: fit-content;
    }
    .gc-pill__dot{ width:8px; height:8px; border-radius:999px; background: rgba(245,158,11,.9); }
    .gc-pill.ok .gc-pill__dot{ background: rgba(34,197,94,.95); }
    .gc-pill.bad .gc-pill__dot{ background: rgba(239,68,68,.95); }
    .gc-note{ margin-top:10px; opacity:.85; font-size:12px; line-height:1.35; }
    .gc-cta{ display:flex; gap:10px; margin-top:12px; flex-wrap:wrap; }

    .gc-mint__grid{
      display:grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }
    @media (max-width: 980px){
      .gc-mint__grid{ grid-template-columns: 1fr 1fr; }
    }
    .gc-mint__cell{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.14);
      border-radius: 12px;
      padding: 10px 10px;
    }
    .gc-mint__k{ font-size:11px; opacity:.75; }
    .gc-mint__v{ font-size:13px; font-weight:700; margin-top:4px; }

    #gcMint[disabled]{ opacity:.55; cursor:not-allowed; }
    .gc-mint__elig{ margin-top:8px; font-size:12px; opacity:.85; }

    .gc-nft{
      margin-top: 12px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.14);
      border-radius: 14px;
      padding: 10px;
      display:flex;
      flex-direction:column;
      gap: 8px;
      align-items:center;
    }
    .gc-nft img{ width: min(330px, 100%); border-radius: 12px; display:block; }
    .gc-nft__note{ font-size:11px; opacity:.75; text-align:center; max-width: 420px; }

    .gc-footer-note{ margin: 14px 0 0; opacity:.75; font-size:12px; }

    /* Modal */
    .gc-modal[aria-hidden="true"]{ display:none; }
    .gc-modal{ position:fixed; inset:0; z-index:9999; }
    .gc-modal__backdrop{ position:absolute; inset:0; background: rgba(0,0,0,.6); }
    .gc-modal__panel{
      position:relative;
      width: min(980px, calc(100% - 24px));
      margin: 36px auto;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(8,8,8,.92);
      color:#fff;
      padding: 14px 14px 16px;
      backdrop-filter: blur(12px);
      box-shadow: 0 18px 60px rgba(0,0,0,.55);
    }
    .gc-modal__head{ display:flex; justify-content:space-between; align-items:center; }
    .gc-modal__badge{ display:flex; gap:8px; align-items:center; font-size:12px; opacity:.85; }
    .gc-modal__close{
      width: 32px; height: 32px;
      border-radius: 10px;
      border:1px solid rgba(255,255,255,.16);
      background: rgba(0,0,0,.18);
      color:#fff;
      font-size:18px;
      cursor:pointer;
      display:flex; align-items:center; justify-content:center;
    }
    .gc-modal__title{ margin: 8px 0 2px; font-size: 18px; }
    .gc-modal__sub{ margin: 0 0 10px; font-size: 12px; opacity:.75; }

    .gc-modal__count{
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.20);
      border-radius: 12px;
      padding: 10px;
      margin-bottom: 10px;
      width: fit-content;
    }
    .gc-count__k{ font-size: 10px; letter-spacing: .12em; opacity:.75; }
    .gc-count__v{ font-size: 16px; font-weight: 800; margin-top: 4px; }
    .gc-count__u{ font-size: 11px; opacity:.75; margin-top: 2px; }

    .gc-meta-grid{
      display:grid;
      grid-template-columns: 320px 1fr;
      gap: 14px;
      align-items:start;
    }
    @media (max-width: 820px){
      .gc-meta-grid{ grid-template-columns:1fr; }
      .gc-meta-grid__img{ max-width: 380px; }
    }
    .gc-meta-grid__img{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      border-radius: 12px;
      padding: 10px;
    }
    .gc-meta-grid__img img{ width: 100%; border-radius: 12px; display:block; }
    .gc-meta-grid__top{
      display:grid;
      grid-template-columns: 180px 1fr 180px;
      gap: 12px;
      margin-bottom: 10px;
    }
    @media (max-width: 980px){
      .gc-meta-grid__top{ grid-template-columns: 1fr; }
    }
    .gc-meta-grid__k{ font-size: 11px; opacity:.75; }
    .gc-meta-grid__v{ font-size: 12px; opacity:.95; margin-top: 4px; }
    .gc-link{ color: rgba(245,158,11,.95); word-break: break-word; }
    .gc-attrs{ display:flex; flex-direction:column; gap: 6px; margin-top: 6px; }
    .gc-attr{
      display:grid;
      grid-template-columns: 160px 1fr;
      gap: 10px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.14);
      border-radius: 10px;
      padding: 8px 10px;
    }
    .gc-attr__k{ opacity:.8; font-size: 12px; }
    .gc-attr__v{ font-size: 12px; }
    .gc-attrs__empty{ opacity:.7; font-size: 12px; }

    .gc-meta-grid__actions{ display:flex; gap: 10px; align-items:center; flex-wrap:wrap; margin-top: 12px; }
    .gc-hint{ font-size: 12px; opacity:.8; }
    .gc-modal__footnote{ margin-top: 12px; font-size: 11px; opacity:.7; }
  </style>

  <script>
    (function(){
      // read Astro base (important for staging/prod parity)
      const BASE = import.meta.env.BASE_URL || "/";

      const btn = document.getElementById("gcViewMeta");
      const modal = document.getElementById("gcMetaModal");
      const closeBtn = document.getElementById("gcMetaClose");
      const hint = document.getElementById("gcMetaHint");

      const rawBtn = document.getElementById("gcMetaRaw");
      const copyBtn = document.getElementById("gcMetaCopy");
      const nameEl = document.getElementById("gcMetaName");
      const descEl = document.getElementById("gcMetaDesc");
      const extEl  = document.getElementById("gcMetaExt");
      const imgEl  = document.getElementById("gcMetaImage");
      const attrsEl = document.getElementById("gcMetaAttrs");

      const cdHero = document.getElementById("gcCountdown");
      const utcHero = document.getElementById("gcCloseUtc");
      const cdMeta = document.getElementById("gcMetaCountdown");
      const utcMeta = document.getElementById("gcMetaUtc");

      function withBasePath(p){
        const base = (typeof BASE === "string" && BASE) ? BASE : "/";
        const clean = String(p || "");
        if (!clean) return clean;
        if (!clean.startsWith("/")) return clean;
        return base.endsWith("/") ? (base.slice(0,-1) + clean) : (base + clean);
      }

      function open(){
        modal.setAttribute("aria-hidden","false");
        document.body.style.overflow = "hidden";
      }
      function close(){
        modal.setAttribute("aria-hidden","true");
        document.body.style.overflow = "";
        if (hint) hint.textContent = "";
      }

      function setAttrs(attrs){
        attrsEl.innerHTML = "";
        if (!Array.isArray(attrs) || attrs.length === 0){
          const d = document.createElement("div");
          d.className = "gc-attrs__empty";
          d.textContent = "No attributes found.";
          attrsEl.appendChild(d);
          return;
        }
        for (const a of attrs){
          const k = a && (a.trait_type || a.traitType || a.key) ? String(a.trait_type || a.traitType || a.key) : "Trait";
          const v = a && (a.value !== undefined) ? String(a.value) : "—";
          const row = document.createElement("div");
          row.className = "gc-attr";
          row.innerHTML = `<div class="gc-attr__k"></div><div class="gc-attr__v mono"></div>`;
          row.querySelector(".gc-attr__k").textContent = k;
          row.querySelector(".gc-attr__v").textContent = v;
          attrsEl.appendChild(row);
        }
      }

      function setCountdown(targetUtcIso){
        if (!targetUtcIso) return;
        const target = new Date(targetUtcIso).getTime();
        const fmtUtc = () => targetUtcIso;

        const tick = () => {
          const now = Date.now();
          let diff = Math.max(0, target - now);

          const d = Math.floor(diff / (24*3600*1000)); diff -= d*(24*3600*1000);
          const h = Math.floor(diff / (3600*1000)); diff -= h*(3600*1000);
          const m = Math.floor(diff / (60*1000)); diff -= m*(60*1000);
          const s = Math.floor(diff / 1000);

          const txt = `${d}d ${String(h).padStart(2,"0")}h ${String(m).padStart(2,"0")}m ${String(s).padStart(2,"0")}s`;

          if (cdHero) cdHero.textContent = txt;
          if (utcHero) utcHero.textContent = fmtUtc();
          if (cdMeta) cdMeta.textContent = txt;
          if (utcMeta) utcMeta.textContent = fmtUtc();
        };

        tick();
        setInterval(tick, 1000);
      }

      async function loadMetadata(){
        const CFG = window.CAPI_CONFIG || {};
        const G = CFG.genesisNft || {};
        const jsonPath = withBasePath(G.metadataJsonPath || "/genesis/metadata/1.json");
        const imagePath = withBasePath(G.imagePath || "/genesis/images/genesis.png");

        // keep links consistent with config
        rawBtn.href = jsonPath;
        imgEl.src = imagePath;

        // countdown (same data used on hero)
        if (G.mintClosesUtcIso) setCountdown(G.mintClosesUtcIso);

        try{
          const r = await fetch(jsonPath, { cache: "no-store" });
          if (!r.ok) throw new Error("HTTP " + r.status);
          const data = await r.json();

          nameEl.textContent = data.name || "Genesis Council";
          descEl.textContent = data.description || "—";

          const external = data.external_url || data.externalUrl || "";
          if (external){
            extEl.textContent = external;
            extEl.href = external;
            extEl.style.pointerEvents = "";
            extEl.style.opacity = "1";
          } else {
            extEl.textContent = "—";
            extEl.href = "#";
            extEl.style.pointerEvents = "none";
            extEl.style.opacity = ".7";
          }

          // Allow metadata to override image if present — but only after it loads successfully.
          // This avoids the "image appears then disappears" issue when metadata points to a different origin
          // (e.g., production URL while you're testing on staging) or when the remote image is temporarily unavailable.
          if (data.image){
            const candidateRaw = String(data.image || "").trim();

            // Rewrite production absolute URLs to the current origin when the path matches our hosted assets.
            // Example: https://capitoken.org/genesis/images/genesis.png -> /genesis/images/genesis.png (with BASE)
            let candidate = candidateRaw;
            try{
              const u = new URL(candidateRaw, window.location.href);
              if (u.pathname && u.pathname.startsWith("/genesis/images/")){
                candidate = withBasePath(u.pathname);
              } else {
                candidate = u.href;
              }
            } catch(_){
              // If it's not a valid URL, leave as-is (could be ipfs:// or plain path)
              candidate = candidateRaw;
              if (candidate.startsWith("/genesis/images/")) candidate = withBasePath(candidate);
            }

            // Preload and only swap src if it loads.
            const probe = new Image();
            probe.onload = () => { imgEl.src = candidate; };
            probe.onerror = () => { /* keep local imagePath */ };
            probe.src = candidate;
          }

          setAttrs(data.attributes || []);
          copyBtn.dataset.json = JSON.stringify(data, null, 2);
        } catch (e){
          nameEl.textContent = "—";
          descEl.textContent = "Could not load metadata. Please try again.";
          extEl.textContent = "—";
          extEl.href = "#";
          setAttrs([]);
          copyBtn.dataset.json = "";
          if (hint) hint.textContent = "Metadata fetch failed. Check if the JSON path is reachable.";
        }
      }

      btn && btn.addEventListener("click", async () => {
        open();
        await loadMetadata();
      });

      closeBtn && closeBtn.addEventListener("click", close);

      modal && modal.addEventListener("click", (e) => {
        const t = e.target;
        if (t && t.getAttribute && t.getAttribute("data-close") === "1") close();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal && modal.getAttribute("aria-hidden") === "false") close();
      });

      copyBtn && copyBtn.addEventListener("click", async () => {
        const txt = copyBtn.dataset.json || "";
        if (!txt){
          if (hint) hint.textContent = "Nothing to copy.";
          return;
        }
        try{
          await navigator.clipboard.writeText(txt);
          if (hint) hint.textContent = "Copied ✅";
          setTimeout(() => { if (hint) hint.textContent = ""; }, 1200);
        } catch(_){
          if (hint) hint.textContent = "Copy failed. Your browser may block clipboard access.";
        }
      });

      // Keep the hero Raw JSON link aligned to config too (optional)
      const rawLink = document.getElementById("gcRawJsonLink");
      if (rawLink){
        const CFG = window.CAPI_CONFIG || {};
        const G = CFG.genesisNft || {};
        rawLink.href = withBasePath(G.metadataJsonPath || rawLink.getAttribute("href"));
      }
    })();
  </script>
</BaseLayout>