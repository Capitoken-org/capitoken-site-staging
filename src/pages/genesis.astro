---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CAPI Genesis Council">
  <main class="gcWrap">
    <section class="gcHero">
      <div class="gcBreadcrumb">• Genesis Council</div>
      <h1 class="gcTitle">CAPI Genesis Council</h1>
      <p class="gcSubtitle">
        This page is an on-chain eligibility portal. Connect your wallet to see your exact CAPI balance and how much you're
        missing. This NFT is an optional membership layer for identity and community direction. It does not grant financial
        rights. If it’s not listed on capitoken.org, assume it’s not official.
      </p>

      <div class="gcActions">
        <button id="gcConnectBtn" class="btnPrimary" type="button">Connect Wallet</button>
        <button id="gcRefreshBtn" class="btnGhost" type="button">Refresh</button>
        <button id="gcViewMetaBtn" class="btnGhost" type="button">View Metadata</button>
        <button id="gcRawJsonBtn" class="btnGhost" type="button">Raw JSON</button>
      </div>

      <div class="gcStatusRow">
        <div class="gcStatusItem"><span class="gcLabel">Wallet</span><span id="gcWallet" class="gcValue">—</span></div>
        <div class="gcStatusItem"><span class="gcLabel">Network</span><span id="gcNetwork" class="gcValue">—</span></div>
      </div>

      <div id="gcCountdownBanner" class="gcCountdown">
        <div class="gcCountdownTop">⏳ MINT CLOSES IN</div>
        <div id="gcCountdownBig" class="gcCountdownBig">—</div>
        <div id="gcCloseUtc" class="gcCountdownUtc">—</div>
      </div>
    </section>

    <section class="gcGrid">
      <div class="gcCard">
        <div class="gcCardTitle">Eligibility (On-chain)</div>

        <div class="gcRow">
          <div class="gcRowLabel">Required</div>
          <div id="gcRequired" class="gcRowValue">—</div>
        </div>
        <div class="gcRow">
          <div class="gcRowLabel">Your balance</div>
          <div id="gcBalance" class="gcRowValue">—</div>
        </div>
        <div class="gcRow">
          <div class="gcRowLabel">Short by</div>
          <div id="gcShortBy" class="gcRowValue">—</div>
        </div>

        <div class="gcBadgeRow">
          <span id="gcEligiblePill" class="pill pill-muted">Not checked</span>
          <span id="gcReadMode" class="gcBadgeText">—</span>
        </div>

        <div id="gcNote" class="gcHint" hidden></div>

        <div class="gcButtons">
          <a class="btnGhost" href="/#launch-panel">Go to Launch Panel</a>
          <a class="btnGhost" href="/verify">Verify Official Links</a>
        </div>
      </div>

      <div class="gcCard">
        <div class="gcCardTitle">Mint (ERC-721)</div>

        <div class="gcRow3">
          <div><div class="gcTiny">Max supply</div><div id="gcMaxSupply" class="gcBig">—</div></div>
          <div><div class="gcTiny">Max per wallet</div><div id="gcMaxPerWallet" class="gcBig">—</div></div>
          <div><div class="gcTiny">Contract</div><div id="gcNftContract" class="gcBig">—</div></div>
        </div>

        <button id="gcMintBtn" class="btnPrimary btnDisabled" type="button" disabled>Mint (coming soon)</button>
        <div id="gcMintStatus" class="gcHint">Mint is free (gas only). The official contract address will be posted here once deployed and verified.</div>

        <div class="gcNftFrame">
          <img class="gcNftImg" src="/genesis/images/genesis.png" alt="Genesis Council NFT preview" />
          <div class="gcNftFoot">Safety: never trust DMs. Always verify the contract address on this website before interacting.</div>
        </div>
      </div>
    </section>
  </main>

  <div id="gcMetaOverlay" class="gcModal" hidden>
    <div class="gcModalBackdrop"></div>
    <div class="gcModalBox" role="dialog" aria-modal="true" aria-label="Genesis Council Metadata">
      <button id="gcMetaClose" class="gcModalClose" type="button" aria-label="Close">✕</button>

      <div class="gcModalHeader">
        <div class="gcModalPill">● Metadata</div>
        <div class="gcModalTitle">Genesis Council Metadata</div>
        <div class="gcModalSub">Friendly preview for non-technical users. Raw JSON is still available.</div>
      </div>

      <div class="gcModalCountdownWrap">
        <div class="gcModalCountdownTop">MINT CLOSES IN</div>
        <div id="gcMetaCountdown" class="gcModalCountdownBig">—</div>
        <div id="gcMetaCloseUtc" class="gcModalCountdownUtc">—</div>
      </div>

      <div class="gcModalGrid">
        <div class="gcModalLeft">
          <img id="gcMetaImg" class="gcModalImg" src="/genesis/images/genesis.png" alt="Genesis Council image" />
        </div>
        <div class="gcModalRight">
          <div class="gcMetaBlock"><div class="gcMetaLabel">Name</div><div id="gcMetaName" class="gcMetaValue">—</div></div>
          <div class="gcMetaBlock"><div class="gcMetaLabel">Description</div><div id="gcMetaDesc" class="gcMetaValue">—</div></div>
          <div class="gcMetaBlock"><div class="gcMetaLabel">External URL</div><a id="gcMetaUrl" class="gcMetaLink" href="#" target="_blank" rel="noopener noreferrer">—</a></div>
          <div class="gcMetaDivider"></div>
          <div class="gcMetaLabel">Attributes</div>
          <div id="gcMetaAttrs" class="gcAttrs"></div>
          <div class="gcModalBtns">
            <button id="gcMetaOpenJson" class="btnGhost" type="button">Open Raw JSON</button>
            <button id="gcMetaCopyJson" class="btnPrimary" type="button">Copy JSON</button>
          </div>
          <div id="gcMetaMsg" class="gcFinePrint"></div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="/js/capi-config.js"></script>
  <script is:inline src="/js/genesis-check.js"></script>

  <style>
    .gcWrap{max-width:1100px;margin:0 auto;padding:28px 18px 70px}
    .gcBreadcrumb{opacity:.8;font-size:12px;margin-bottom:10px}
    .gcTitle{font-size:44px;line-height:1.05;margin:0 0 10px}
    .gcSubtitle{max-width:860px;opacity:.9}
    .gcActions,.gcButtons,.gcModalBtns{display:flex;gap:10px;flex-wrap:wrap}
    .gcActions{margin:14px 0 10px}
    .gcStatusRow{display:flex;gap:18px;flex-wrap:wrap;margin:8px 0 14px}
    .gcStatusItem{display:grid;gap:4px}
    .gcLabel,.gcTiny,.gcMetaLabel{font-size:12px;opacity:.8}
    .gcValue{font-size:12px;padding:6px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.25)}
    .gcCountdown{border:1px solid rgba(255,165,0,.45);background:rgba(255,165,0,.08);border-radius:14px;padding:12px 14px;max-width:720px}
    .gcCountdownTop,.gcModalCountdownTop{font-size:11px;opacity:.85;letter-spacing:.06em}
    .gcCountdownBig{font-size:26px;font-weight:700;margin-top:4px}
    .gcCountdownUtc,.gcModalCountdownUtc{font-size:12px;opacity:.85;margin-top:2px}
    .gcGrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
    .gcCard{border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.30);border-radius:18px;padding:16px;backdrop-filter:blur(10px)}
    .gcCardTitle{font-size:14px;opacity:.9;margin-bottom:12px;font-weight:700}
    .gcRow{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.08)}
    .gcRowLabel{font-size:12px;opacity:.85}.gcRowValue{font-size:12px;opacity:.95;text-align:right}
    .gcRow3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}
    .gcBig{font-size:14px;font-weight:700}
    .gcBadgeRow{display:flex;align-items:center;gap:10px;margin:10px 0}.gcBadgeText,.gcHint,.gcNftFoot,.gcFinePrint{font-size:11px;opacity:.75}
    .pill{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:6px 10px;border:1px solid rgba(255,255,255,.14);font-size:12px}
    .pill-ok{background:rgba(0,255,160,.12);color:#b7ffd7}.pill-off{background:rgba(255,90,90,.12);color:#ffd0d0}.pill-muted{background:rgba(255,255,255,.06);color:#e8e8e8}
    .gcNftFrame{margin-top:10px}.gcNftImg{width:100%;max-width:320px;display:block;border-radius:14px;border:1px solid rgba(255,255,255,.12)}
    .btnPrimary,.btnGhost{padding:9px 12px;border-radius:10px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
    .btnPrimary{border:1px solid rgba(255,165,0,.55);background:rgba(255,165,0,.85);color:#111;font-weight:700}
    .btnGhost{border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.22);color:rgba(255,255,255,.92)}
    .btnDisabled{opacity:.6;cursor:not-allowed}
    .gcModal{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px}
    .gcModalBackdrop{position:absolute;inset:0;background:rgba(0,0,0,.55)}
    .gcModalBox{position:relative;width:min(980px,100%);border-radius:18px;border:1px solid rgba(255,255,255,.14);background:rgba(10,10,10,.92);backdrop-filter:blur(14px);padding:16px;z-index:1}
    .gcModalClose{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:10px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.35);color:#fff;cursor:pointer}
    .gcModalHeader{display:grid;gap:6px;margin-bottom:12px}.gcModalPill{font-size:12px;opacity:.8}.gcModalTitle{font-size:18px;font-weight:800}.gcModalSub{font-size:12px;opacity:.8}
    .gcModalCountdownWrap{border:1px solid rgba(255,165,0,.38);background:rgba(255,165,0,.08);border-radius:14px;padding:10px 12px;margin-bottom:12px;max-width:520px}
    .gcModalCountdownBig{font-size:22px;font-weight:800;margin-top:4px}
    .gcModalGrid{display:grid;grid-template-columns:360px 1fr;gap:14px}
    .gcModalImg{width:100%;max-width:360px;border-radius:14px;border:1px solid rgba(255,255,255,.12);display:block}
    .gcMetaBlock{margin-bottom:10px}.gcMetaValue{font-size:12px;opacity:.95}.gcMetaLink{font-size:12px;color:rgba(255,200,120,.95);text-decoration:none}
    .gcMetaDivider{height:1px;background:rgba(255,255,255,.10);margin:10px 0}
    .gcAttrs{display:grid;gap:8px;margin-top:8px}.gc-attr,.kv{display:grid;grid-template-columns:140px 1fr;gap:10px}.k{font-size:12px;opacity:.75}.v{font-size:12px;opacity:.95}
    @media (max-width:980px){.gcGrid,.gcModalGrid{grid-template-columns:1fr}.gcTitle{font-size:36px}}
    [hidden]{display:none !important}
  </style>
</BaseLayout>
