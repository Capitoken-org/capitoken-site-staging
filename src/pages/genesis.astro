---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CAPI Genesis Council">
  <main class="gc-page">

    <section class="gc-hero">
      <h1>CAPI Genesis Council</h1>
      <p>
        This page is an on-chain eligibility portal. Connect your wallet to see your exact CAPI balance.
        This NFT does not grant financial rights.
      </p>

      <div class="actions">
        <button id="connectBtn" class="btn primary">Connect Wallet</button>
        <button id="refreshBtn" class="btn">Refresh</button>
        <button id="metaBtn" class="btn">View Metadata</button>
        <a href="/genesis/metadata/1.json" target="_blank" class="btn">Raw JSON</a>
      </div>

      <div class="wallet-info">
        Wallet: <span id="wallet">—</span>
      </div>
    </section>

    <section class="grid">
      <div class="card">
        <h3>Eligibility (On-chain)</h3>
        <p>Required: ≥ 150,000,000 CAPI</p>
        <p>Your balance: <span id="balance">—</span></p>
        <p>Short by: <span id="short">—</span></p>
      </div>

      <div class="card">
        <h3>Mint (ERC-721)</h3>
        <p>Max supply: 7000</p>
        <p>Max per wallet: 1</p>
        <button class="btn primary" disabled>Mint (coming soon)</button>

        <div class="nft-preview">
          <img src="/genesis/images/genesis.png" alt="Genesis NFT" />
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL -->
  <div id="modal" class="modal hidden">
    <div class="modal-box">
      <button id="closeModal" class="close">×</button>
      <h2>Genesis Council Metadata</h2>
      <div id="metaContent"></div>
    </div>
  </div>

  <script is:inline src="/js/genesis-check.js"></script>

  <style>
    .gc-page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 20px;
    }

    .actions { margin: 15px 0; display:flex; gap:10px; flex-wrap:wrap; }

    .btn {
      padding:8px 12px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.2);
      background:rgba(0,0,0,.2);
      color:white;
      cursor:pointer;
      font-weight:600;
    }

    .primary { background:#f59e0b; color:black; }

    .grid {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:20px;
      margin-top:20px;
    }

    @media (max-width: 900px){
      .grid { grid-template-columns:1fr; }
    }

    .card {
      padding:20px;
      border:1px solid rgba(255,255,255,.15);
      border-radius:16px;
      background:rgba(0,0,0,.25);
    }

    .nft-preview img {
      width:100%;
      max-width:320px;
      border-radius:12px;
      margin-top:15px;
    }

    /* Modal */
    .modal {
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.7);
      display:flex;
      justify-content:center;
      align-items:center;
      z-index:9999;
    }

    .hidden { display:none; }

    .modal-box {
      background:#111;
      padding:30px;
      border-radius:16px;
      width:90%;
      max-width:700px;
    }

    .close {
      float:right;
      background:none;
      border:none;
      color:white;
      font-size:20px;
      cursor:pointer;
    }
  </style>
</BaseLayout>