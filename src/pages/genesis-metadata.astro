---
import BaseLayout from "../layouts/BaseLayout.astro";

const BASE = import.meta.env.BASE_URL || "/";
const withBase = (p) => {
  const clean = String(p || "");
  return clean.startsWith("/") ? `${BASE}${clean.slice(1)}` : `${BASE}${clean}`;
};
---

<BaseLayout title="Genesis Metadata | Capitoken" description="Genesis Council metadata preview (redirect).">
  <main class="container">
    <section class="hero">
      <div class="pill"><span class="pill__dot"></span><span>Genesis Council</span></div>
      <h1>Metadata moved</h1>
      <p class="hero__lead">
        The user-friendly metadata view now lives inside <a href={withBase("/genesis")}>/genesis</a> as a modal.
      </p>
      <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
        <a class="btn btn--primary" href={withBase("/genesis")}>Go to Genesis Council</a>
        <a class="btn" href={withBase("/genesis/metadata/1.json")} target="_blank" rel="noreferrer">Open Raw JSON</a>
      </div>
    </section>
  </main>

  <script is:inline>
    // Soft-redirect so old shared links never break.
    // (Keeps SEO + prevents confusion if someone saved /genesis-metadata)
    setTimeout(() => { window.location.href = "{withBase('/genesis')}"; }, 700);
  </script>
</BaseLayout>
